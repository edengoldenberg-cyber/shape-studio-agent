# WhatsApp — Green API (outbound sending)
GREEN_API_URL=1103.api.green-api.com   # host only, no https://  (get from Green API console)
GREEN_API_INSTANCE_ID=                 # numeric instance ID from Green API console
GREEN_API_TOKEN=                       # API token from Green API console
WHATSAPP_VERIFY_TOKEN=                 # still used for Meta inbound webhook verification
STUDIO_OWNER_PHONE=972XXXXXXXXX        # E.164 format, no + (alerts go here)

# Meta Lead Ads — courier recruitment pipeline
META_PAGE_ACCESS_TOKEN=           # Page access token to fetch lead field data from Graph API
META_LEADS_VERIFY_TOKEN=shape_studio_leads
META_APP_SECRET=                  # App secret for webhook signature verification (optional in dev)
NOTIFY_PHONES=972XXXXXXXXX,972YYYYYYYYY  # Comma-separated team phones to alert on new lead

# Arbox CRM
ARBOX_API_KEY=
ARBOX_BASE_URL=https://api.arbox.co.il/v1
ARBOX_LOCATION_ID=

# OpenAI (for AI agent responses)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# App
PORT=3000
NODE_ENV=development
TZ=Asia/Jerusalem

# Quiet hours (24h format, Israel time)
QUIET_HOUR_START=22
QUIET_HOUR_END=8
QUIET_HOUR_MORNING_RELEASE=08:30
